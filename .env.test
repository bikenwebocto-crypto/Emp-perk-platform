# ─────────────────────────────────────────────────────────────
# Test-only environment. COMMIT-SAFE placeholders — fill in real
# (non-production) values locally; never put production secrets here.
# ─────────────────────────────────────────────────────────────

# Playwright (tests/playwright.config.ts) — external base URL only.
E2E_BASE_URL=http://localhost:3000
E2E_BROWSER=chromium
# Set to 'true' to have Playwright boot the dev server itself.
E2E_WEB_SERVER_START=
E2E_WEB_SERVER_COMMAND=npm run dev

# E2E account credentials (one per role). Must match prisma/seed-test.ts.
E2E_EMPLOYEE_EMAIL=
E2E_EMPLOYEE_PASSWORD=
E2E_MERCHANT_EMAIL=
E2E_MERCHANT_PASSWORD=
E2E_COMPANY_ADMIN_EMAIL=
E2E_COMPANY_ADMIN_PASSWORD=
E2E_SUPER_ADMIN_EMAIL=
E2E_SUPER_ADMIN_PASSWORD=

# Optional live-database latency probes (tests/db, tests/performance).
# Leave empty to skip them. NEVER point this at production.
TEST_DATABASE_URL=