{
  "info": {
    "name": "Leads API",
    "description": "Public lead submission (POST /api/leads) and admin lead management (/api/admin/leads).\n\nSet `baseUrl`. For admin requests set `adminCookie` to the Supabase auth cookie(s) copied from a logged-in admin browser session (DevTools → Application → Cookies, e.g. `sb-<ref>-auth-token=...`).\n\nRun the folders in order. Note: public endpoint is rate limited to 10 requests / 10 min per IP — a full run uses ~14, so wait or raise the limit locally between runs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh unique emails per run so duplicates don't block create tests",
          "if (!pm.collectionVariables.get(\"runId\") || pm.info.requestName === \"Employer enquiry (201)\") {",
          "  const id = Date.now();",
          "  pm.collectionVariables.set(\"runId\", id);",
          "  [\"employer\",\"merchant\",\"waitlist\",\"contact\",\"form\"].forEach(k => pm.collectionVariables.set(k + \"Email\", `${k}.${id}@example.com`));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminCookie",
      "value": ""
    },
    {
      "key": "allowedOrigin",
      "value": "http://localhost:4321"
    },
    {
      "key": "leadId",
      "value": ""
    },
    {
      "key": "employerLeadId",
      "value": ""
    },
    {
      "key": "contactLeadId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "employerEmail",
      "value": ""
    },
    {
      "key": "merchantEmail",
      "value": ""
    },
    {
      "key": "waitlistEmail",
      "value": ""
    },
    {
      "key": "contactEmail",
      "value": ""
    },
    {
      "key": "formEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public - create leads",
      "item": [
        {
          "name": "Employer enquiry (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"success true + id\", () => { pm.expect(j.success).to.eql(true); pm.expect(j.id).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"employerLeadId\", j.id);",
                  "pm.collectionVariables.set(\"leadId\", j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"form_key\": \"employer_enquiry\",\n  \"first_name\": \"Ada\",\n  \"last_name\": \"Employer\",\n  \"email\": \"{{employerEmail}}\",\n  \"phone\": \"99123456\",\n  \"company\": \"Acme Ltd\",\n  \"role\": \"HR Manager\",\n  \"website\": \"acme.com\",\n  \"linkedin\": \"https://www.linkedin.com/company/acme\",\n  \"company_size\": \"10-49\",\n  \"source\": \"Google Search\",\n  \"consent-1\": \"I agree to the Privacy Policy\",\n  \"consent_version\": \"v1\",\n  \"page_url\": \"https://example.com/form\",\n  \"utm_source\": \"postman\",\n  \"utm_medium\": \"test\",\n  \"utm_campaign\": \"qa\"\n}",
