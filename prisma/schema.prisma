// Complaint Management
// ─────────────────────────────────────────────────────────────

model Complaint {
  id              String            @id @default(uuid()) @db.Uuid
  offerId         String?           @db.Uuid
  employeeId      String?           @db.Uuid
  merchantId      String?           @db.Uuid
  companyId       String?           @db.Uuid
  complaintType   ComplaintType
  category        String?           @db.VarChar(50)
  description     String
  evidenceUrls    Json?
  status          ComplaintStatus   @default(OPEN)
  priority        ComplaintPriority @default(MEDIUM)
  escalationNote  String?
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  offer       MerchantOffer?        @relation(fields: [offerId], references: [id])
  employee    Employee?             @relation(fields: [employeeId], references: [id])
  merchant    Merchant?             @relation(fields: [merchantId], references: [id])
  company     Company?              @relation(fields: [companyId], references: [id])
  escalations ComplaintEscalation[]
  actions     ComplaintAction[]

  @@index([employeeId])
  @@index([merchantId])
  @@index([companyId])
  @@index([offerId])
  @@index([status])
  @@index([companyId, status])
  @@map("complaints")
}

model ComplaintEscalation {
  id             String    @id @default(uuid()) @db.Uuid
  complaintId    String    @db.Uuid
  companyAdminId String    @db.Uuid
  superAdminId   String?   @db.Uuid
  reason         String
  status         String    @default("PENDING") // PENDING, RESOLVED
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  complaint    Complaint    @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  companyAdmin CompanyAdmin @relation(fields: [companyAdminId], references: [id])
  superAdmin   AdminUser?   @relation(fields: [superAdminId], references: [id])

  @@index([complaintId])
  @@map("complaint_escalations")
}

model ComplaintAction {
  id             String   @id @default(uuid()) @db.Uuid
  complaintId    String   @db.Uuid
  actorType      String   @db.VarChar(50) // COMPANY_ADMIN, SUPER_ADMIN, MERCHANT, EMPLOYEE
  adminId        String?  @db.Uuid
  companyAdminId String?  @db.Uuid
  employeeId     String?  @db.Uuid
  merchantId     String?  @db.Uuid
  actionType     String   @db.VarChar(50) // REVIEWED, CLARIFICATION_REQUESTED, ESCALATED, RESOLVED, REJECTED, RESPONDED
  notes          String?
  createdAt      DateTime @default(now())

  complaint    Complaint     @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  admin        AdminUser?    @relation("AdminComplaintActions", fields: [adminId], references: [id])
  companyAdmin CompanyAdmin? @relation("CompanyAdminComplaintActions", fields: [companyAdminId], references: [id])
  employee     Employee?     @relation("EmployeeComplaintActions", fields: [employeeId], references: [id])
  merchant     Merchant?     @relation("MerchantComplaintActions", fields: [merchantId], references: [id])

  @@index([complaintId])
  @@map("complaint_actions")
}

