  merchantWebsite String?                  @db.VarChar(500)
  merchantPhone   String                   @db.VarChar(50)
  merchantEmail   String                   @db.VarChar(255)
  reason          String?
  status          MerchantSuggestionStatus @default(PENDING)
  adminNotes      String?
  rejectionReason String?
  reviewedById    String?                  @db.Uuid
  reviewedAt      DateTime?
  merchantId      String?                  @unique @db.Uuid
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  employee Employee  @relation(fields: [employeeId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  merchant Merchant? @relation(fields: [merchantId], references: [id])

  @@index([employeeId, createdAt])
  @@index([status, createdAt])
  @@index([merchantEmail])
  @@index([merchantPhone])
  @@index([companyId])
  @@map("merchant_suggestions")
}

model Lead {
  id       String     @id @default(uuid()) @db.Uuid
  type     LeadType
  source   LeadSource @default(PUBLIC_FORM)
  status   LeadStatus @default(NEW)

  // shared
  firstName      String     @db.VarChar(100)
  lastName       String     @db.VarChar(100)
  email          String     @db.VarChar(255)
  phone          String?    @db.VarChar(50)
  companyName    String     @db.VarChar(255)
  hearAbout      String?    @db.VarChar(255)
  message        String?    @db.VarChar(2000)
  consentAt      DateTime?
  consentVersion String?    @db.VarChar(50)

  // merchant-only (nullable)
  industry   String?  @db.VarChar(100)
  cities     String[]   @default([])
  websiteUrl String?  @db.VarChar(500)
  socialUrl  String?  @db.VarChar(500)

  // employer-only (nullable)
  companySize String? @db.VarChar(50)
  hqCountry   String? @db.VarChar(100)
  role        String? @db.VarChar(50)

  // link to the real record, set on conversion
  merchantId String?   @unique @db.Uuid
  companyId  String?   @unique @db.Uuid
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type, status])
  @@index([email, type])
  @@map("leads")
}

/// Fixed-window counter backing src/lib/rate-limit.ts. Swappable for Redis by
/// replacing the RateLimiter implementation; no other module reads this table.
model RateLimitCounter {
  key         String   @id @db.VarChar(255)
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("rate_limit_counters")
}
