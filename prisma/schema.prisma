generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id                   String                       @id @default(uuid()) @db.Uuid
  firstName            String                       @db.VarChar(100)
  lastName             String                       @db.VarChar(100)
  role                 AdminRole                    @default(SUPPORT_ADMIN)
  isActive             Boolean                      @default(true)
  avatarUrl            String?                      @db.VarChar(500)
  lastLoginAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  accountId            String?                      @db.Uuid
  actionQueueItems     ActionQueueItem[]
  auditLogs            AuditLog[]                   @relation("AdminAuditLogs")
  issueReviews         IssueReport[]                @relation("AdminIssueReview")
  loginSessions        LoginSession[]
  profileEditReqs      MerchantProfileEditRequest[] @relation("AdminProfileEdit")
  notifications        NotificationEvent[]          @relation("AdminNotification")
  offerReplacementReqs OfferReplacementRequest[]    @relation("AdminOfferReplacement")
  escalatedComplaints  ComplaintEscalation[]
  complaintActions     ComplaintAction[]            @relation("AdminComplaintActions")

  @@index([role])
  @@map("admin_users")
}

model Account {
  authUserId    String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  role          AccountRole
  profileType   ProfileType
  status        AccountStatus  @default(PENDING)
  createdBy     String?        @db.VarChar(255)
  changedBy     String?        @db.VarChar(255)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  employees     Employee[]     @relation("EmployeeAccount")
  merchants     Merchant[]
  companyAdmins CompanyAdmin[] @relation("CompanyAdminAccount")

  @@index([role])
  @@index([status])
  @@map("accounts")
}

model Company {
  id                   String                 @id @default(uuid()) @db.Uuid
  name                 String                 @db.VarChar(255)
  slug                 String                 @unique @db.VarChar(255)
  email                String                 @unique @db.VarChar(255)
  phone                String?                @db.VarChar(50)
  logoUrl              String?                @db.VarChar(500)
  website              String?                @db.VarChar(500)
  employeeCount        Int                    @default(0)
  status               CompanyStatus          @default(PENDING)
  addressLine1         String?                @db.VarChar(255)
  addressLine2         String?                @db.VarChar(255)
  city                 String?                @db.VarChar(100)
  state                String?                @db.VarChar(100)
  postalCode           String?                @db.VarChar(20)
  country              String?                @db.VarChar(100)
  taxId                String?                @db.VarChar(50)
  notes                String?
  approvedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  adminNote            String?                @db.VarChar(500)
  approvedDomain       String?                @db.VarChar(255)
  industry             String?                @db.VarChar(100)
  approvedById         String?                @db.Uuid
  deletedById          String?                @db.Uuid
  audits               AuditLog[]             @relation("CompanyAuditLogs")
  // categories removed — categories are now global master data
  companyAdmins        CompanyAdmin[]
  billing              CompanyBilling?
  statusHistory        CompanyStatusHistory[]
  csvUploads           CSVUploadJob[]
  employees            Employee[]
  mostPopularMerchants MostPopularMerchant[]
  redemptions          Redemption[]
  complaints           Complaint[]
  reviews              MerchantReview[]
  merchantSuggestions  MerchantSuggestion[]
  lead                 Lead?

  @@index([status])
  @@index([slug])
  @@index([email])
  @@index([status, deletedAt])
  @@map("companies")
}

model CompanyBilling {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @unique @db.Uuid
  plan                 String        @db.VarChar(50)
  billingEmail         String?       @db.VarChar(255)
  billingCycle         String        @default("monthly") @db.VarChar(20)
  pricePerEmployee     Decimal       @default(5.0) @db.Decimal(10, 2)
  currency             String        @default("GBP") @db.VarChar(3)
  stripeCustomerId     String?       @db.VarChar(255)
  stripeSubscriptionId String?       @db.VarChar(255)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  paymentMethodLast4   String?       @db.VarChar(4)
  nextBillingDate      DateTime?
  invoiceCount         Int           @default(0)
  totalPaid            Decimal       @default(0) @db.Decimal(12, 2)
  isTrial              Boolean       @default(false)
  trialEndsAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  billingStatus        BillingStatus @default(ACTIVE)
  renewalDate          DateTime?
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_billing")
}

model CompanyAdmin {
  id               String                @id @default(uuid()) @db.Uuid
  companyId        String                @db.Uuid
  firstName        String                @db.VarChar(100)
  lastName         String                @db.VarChar(100)
  isPrimary        Boolean               @default(false)
  isActive         Boolean               @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  accountId        String?               @db.Uuid
  account          Account?              @relation("CompanyAdminAccount", fields: [accountId], references: [authUserId])
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loginSessions    LoginSession[]
  notifications    NotificationEvent[]   @relation("CompanyAdminNotification")
  auditLogs        AuditLog[]            @relation("CompanyAdminAuditLogs")
  escalations      ComplaintEscalation[]
  complaintActions ComplaintAction[]     @relation("CompanyAdminComplaintActions")

  @@index([companyId])
  @@map("company_admins")
}

model Employee {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  firstName           String                   @db.VarChar(100)
  lastName            String                   @db.VarChar(100)
  employeeId          String?                  @db.VarChar(100)
  department          String?                  @db.VarChar(100)
  jobTitle            String?                  @db.VarChar(100)
  phone               String?                  @db.VarChar(50)
  avatarUrl           String?                  @db.VarChar(500)
  status              EmployeeStatus           @default(INVITED)
  invitedAt           DateTime?
  invitedBy           String?                  @db.Uuid
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  joinMethod          String?                  @db.VarChar(50)
  approvedById        String?                  @db.Uuid
  deletedById         String?                  @db.Uuid
  accountId           String?                  @db.Uuid
  company             Company                  @relation(fields: [companyId], references: [id])
  reports             IssueReport[]
  loginSessions       LoginSession[]
  notifications       NotificationEvent[]      @relation("EmployeeNotification")
  redemptions         Redemption[]
  offerViews          OfferView[]
  auditLogs           AuditLog[]               @relation("EmployeeAuditLogs")
  complaints          Complaint[]
  complaintActions    ComplaintAction[]        @relation("EmployeeComplaintActions")
  reviews             MerchantReview[]
  account             Account?                 @relation("EmployeeAccount", fields: [accountId], references: [authUserId])
  redemptionAttempts  OfferRedemptionAttempt[]
  address             EmployeeAddress?
  merchantSuggestions MerchantSuggestion[]

  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
  @@map("employees")
}

model EmployeeAddress {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @unique @db.Uuid

  addressLine1 String? @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  country      String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_addresses")
}

model OfferRedemptionCapacity {
  id             String    @id @default(uuid()) @db.Uuid
  offerId        String    @unique @db.Uuid
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  lastRedeemedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  offer MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_redemption_capacity")
}

model OfferRedemptionAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  offerId      String   @db.Uuid
  employeeId   String   @db.Uuid
  redemptionId String?  @unique @db.Uuid
  createdAt    DateTime @default(now())

  offer    MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([offerId, employeeId])
  @@index([offerId])
  @@index([employeeId])
  @@map("offer_redemption_attempts")
}

model Merchant {
  id                  String                       @id @default(uuid()) @db.Uuid
  businessName        String                       @db.VarChar(255)
  slug                String                       @unique @db.VarChar(255)
  contactName         String                       @db.VarChar(255)
  contactPhone        String?                      @db.VarChar(50)
  description         String?
  logoUrl             String?                      @db.VarChar(500)
  coverImageUrl       String?                      @db.VarChar(500)
  website             String?                      @db.VarChar(500)
  categoryId          String?                      @db.Uuid
  status              MerchantStatus               @default(PENDING)
  onboardingStep      MerchantOnboardingStep       @default(APPLICATION)
  isFeatured          Boolean                      @default(false)
  isTopRated          Boolean                      @default(false)
  isHomepageMerchant  Boolean                      @default(false)
  displayPriority     Int                          @default(0)
  averageRating       Decimal                      @default(0) @db.Decimal(3, 2)
  totalRedemptions    Int                          @default(0)
  totalSavings        Decimal                      @default(0) @db.Decimal(12, 2)
  addressLine1        String?                      @db.VarChar(255)
  addressLine2        String?                      @db.VarChar(255)
  city                String?                      @db.VarChar(100)
  state               String?                      @db.VarChar(100)
  postalCode          String?                      @db.VarChar(20)
  country             String?                      @db.VarChar(100)
  socialLinks         Json?
  businessHours       Json?
  tags                String[]                     @default([])
  rejectionReason     String?
  notes               String?
  approvedAt          DateTime?
  lastOfferSubmitAt   DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  adminNote           String?                      @db.VarChar(500)
  liveAt              DateTime?
  approvedById        String?                      @db.Uuid
  deletedById         String?                      @db.Uuid
  accountId           String?                      @db.Uuid
  actionQueueItems    ActionQueueItem[]
  audits              AuditLog[]                   @relation("MerchantAuditLogs")
  heroBanners         HeroBanner[]
  issues              IssueReport[]
  loginSessions       LoginSession[]
  branches            MerchantBranch[]
  offers              MerchantOffer[]
  profileEditRequests MerchantProfileEditRequest[]
  statusHistory       MerchantStatusHistory[]
  category            Category?                    @relation(fields: [categoryId], references: [id])
  mostPopularEntries  MostPopularMerchant[]
  notifications       NotificationEvent[]          @relation("MerchantNotification")
  redemptions         Redemption[]
  weeklyPicks         WeeklyPick[]

  complaints       Complaint[]
  complaintActions ComplaintAction[]   @relation("MerchantComplaintActions")
  reviews          MerchantReview[]
  bannerBookings   BannerBooking[]
  account          Account?            @relation(fields: [accountId], references: [authUserId])
  sourceSuggestion MerchantSuggestion?
  lead             Lead?

  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@index([status, categoryId])
  @@index([status, deletedAt])
  @@index([displayPriority])
  @@index([isFeatured])
  @@index([isHomepageMerchant])
  @@map("merchants")
}

model MerchantBranch {
  id                 String       @id @default(uuid()) @db.Uuid
  merchantId         String       @db.Uuid
  name               String       @db.VarChar(255)
  addressLine1       String       @db.VarChar(255)
  addressLine2       String?      @db.VarChar(255)
  city               String       @db.VarChar(100)
  state              String?      @db.VarChar(100)
  postalCode         String       @db.VarChar(20)
  country            String       @db.VarChar(100)
  phone              String?      @db.VarChar(50)
  email              String?      @db.VarChar(255)
  latitude           Decimal?     @db.Decimal(10, 7)
  longitude          Decimal?     @db.Decimal(10, 7)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  branchImages       String[]     @default([])
  branchType         BranchType   @default(IN_STORE)
  deletedAt          DateTime?
  deliveryRadiusKm   Int?
  description        String?
  isNationwide       Boolean      @default(false)
  isPrimary          Boolean      @default(false)
  landmark           String?      @db.VarChar(500)
  openingHours       Json?
  parkingInfo        String?      @db.VarChar(500)
  status             BranchStatus @default(ACTIVE)
  storefrontImageUrl String?      @db.VarChar(500)
  wheelchairAccess   Boolean      @default(false)
  merchant           Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([merchantId, isPrimary])
  @@index([merchantId, status])
  @@index([merchantId, branchType])
  @@index([status])
  @@index([deletedAt])
  @@map("merchant_branches")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(100)
  slug         String     @unique @db.VarChar(100)
  description  String?    @db.VarChar(500)
  icon         String?    @db.VarChar(50)
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  merchants    Merchant[]

  @@map("categories")
}

model MerchantOffer {
  id            String      @id @default(uuid()) @db.Uuid
  merchantId    String      @db.Uuid
  categoryId    String?     @db.Uuid
  title         String      @db.VarChar(255)
  offerType     String      @db.VarChar(50)
  status        OfferStatus @default(DRAFT)
  startDate     DateTime
  endDate       DateTime
  submittedAt   DateTime?
  reviewedAt    DateTime?
  liveAt        DateTime?
  expiresAt     DateTime?
  isFeatured    Boolean     @default(false)
  isExclusive   Boolean     @default(false)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  deletedById   String?     @db.Uuid
  deletedByRole String?     @db.VarChar(50)

  merchant            Merchant                  @relation(fields: [merchantId], references: [id])
  redemptions         Redemption[]
  replacesOffer       MerchantOffer?            @relation("OfferReplacement", fields: [replacesOfferId], references: [id])
  replacedBy          MerchantOffer[]           @relation("OfferReplacement")
  replacementReqAsOld OfferReplacementRequest[] @relation("CurrentOffer")
  replacementReqAsNew OfferReplacementRequest[] @relation("NewOffer")
  capacity            OfferRedemptionCapacity?
  redemptionAttempts  OfferRedemptionAttempt[]

  replacesOfferId String? @db.Uuid

  content        OfferContent?
  pricing        OfferPricing?
  redemption     OfferRedemption?
  review         OfferReview?
  analytics      OfferAnalytics?
  dailyAnalytics DailyOfferAnalytics[]
  views          OfferView[]
  complaints     Complaint[]
  reviews        MerchantReview[]

  @@index([merchantId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([merchantId, status])
  @@index([status, startDate, endDate])
  @@index([replacesOfferId])
  @@index([deletedAt])
  @@map("merchant_offers")
}

model OfferContent {
  id                 String   @id @default(uuid()) @db.Uuid
  offerId            String   @unique @db.Uuid
  shortDescription   String?  @db.VarChar(500)
  description        String?
  termsAndConditions String?
  imageUrls          String[] @default([])
  displayData        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  offer MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_content")
}

model OfferPricing {
  id            String   @id @default(uuid()) @db.Uuid
  offerId       String   @unique @db.Uuid
  pricingType   String   @db.VarChar(50)
  configuration Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offer MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_pricing")
}

model OfferRedemption {
  id                 String   @id @default(uuid()) @db.Uuid
  offerId            String   @unique @db.Uuid
  redemptionType     String?  @db.VarChar(50)
  configuration      Json?
  maxRedemptions     Int?     @default(0)
  currentRedemptions Int      @default(0)
  daysOfWeek         Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  offer MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_redemptions")
}

model OfferReview {
  id                String    @id @default(uuid()) @db.Uuid
  offerId           String    @unique @db.Uuid
  reviewedBy        String?   @db.Uuid
  reviewedAt        DateTime?
  rejectionReason   String?
  reviewNotes       String?
  adminNote         String?
  submissionNotes   String?
  replacementReason String?
  isReplacement     Boolean   @default(false)
  validationErrors  Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  offer MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_reviews")
}

model OfferAnalytics {
  id         String   @id @default(uuid()) @db.Uuid
  offerId    String   @unique @db.Uuid
  saveCount  Int      @default(0)
  viewCount  Int      @default(0)
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  offer MerchantOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("offer_analytics")
}

model OfferReplacementRequest {
  id             String            @id @default(uuid()) @db.Uuid
  currentOfferId String            @db.Uuid
  newOfferId     String            @db.Uuid
  reason         String?
  adminId        String?           @db.Uuid
  adminNotes     String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  status         ReplacementStatus @default(PENDING)
  admin          AdminUser?        @relation("AdminOfferReplacement", fields: [adminId], references: [id])
  currentOffer   MerchantOffer     @relation("CurrentOffer", fields: [currentOfferId], references: [id])
  newOffer       MerchantOffer     @relation("NewOffer", fields: [newOfferId], references: [id])

  @@index([currentOfferId])
  @@index([newOfferId])
  @@index([status])
  @@map("offer_replacement_requests")
}

model MerchantProfileEditRequest {
  id              String     @id @default(uuid()) @db.Uuid
  merchantId      String     @db.Uuid
  requestedFields Json
  reason          String
  adminId         String?    @db.Uuid
  adminNotes      String?
  isApproved      Boolean?
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  admin           AdminUser? @relation("AdminProfileEdit", fields: [adminId], references: [id])
  merchant        Merchant   @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("merchant_profile_edit_requests")
}

model Redemption {
  id             String    @id @default(uuid()) @db.Uuid
  merchantId     String    @db.Uuid
  offerId        String    @db.Uuid
  employeeId     String    @db.Uuid
  companyId      String    @db.Uuid
  redemptionCode String?   @db.VarChar(100)
  discountAmount Decimal   @db.Decimal(10, 2)
  spentAmount    Decimal?  @db.Decimal(10, 2)
  savingsAmount  Decimal   @db.Decimal(10, 2)
  branchId       String?   @db.Uuid
  merchantNotes  String?
  employeeNotes  String?
  isVerified     Boolean   @default(false)
  verifiedBy     String?   @db.Uuid
  verifiedAt     DateTime?

  createdAt DateTime        @default(now())
  company   Company         @relation(fields: [companyId], references: [id])
  employee  Employee        @relation(fields: [employeeId], references: [id])
  merchant  Merchant        @relation(fields: [merchantId], references: [id])
  offer     MerchantOffer   @relation(fields: [offerId], references: [id])
  review    MerchantReview?

  redeemedAt DateTime? // ⚠️ BREAKING: was @default(now()), non-null. Now nullable, set only when isRedeemed → true.

  isSaved    Boolean   @default(false)
  savedAt    DateTime?
  isRedeemed Boolean   @default(false) // true once employee generates a redemption code

  rejectionReason String? // reuses existing isVerified=false for both "pending" and "rejected"; this disambiguates. isVerified stays as your approval flag — no rename.

  // Savings tracker (from earlier in this thread)
  loggedSavingAmount      Decimal?                @db.Decimal(10, 2)
  billAmount              Decimal?                @db.Decimal(10, 2)
  savingMethod            SavingMethod?
  savingValidationStatus  SavingValidationStatus?
  savingValidationMessage String?
  savingLoggedAt          DateTime?
  savingEditedAt          DateTime?
  quantityPurchased       Int? // actual units bought (BOGO savings validation); no index — nothing filters/sorts by it

  @@index([merchantId])
  @@index([offerId])
  @@index([employeeId])
  @@index([companyId])
  @@index([redeemedAt])
  @@index([merchantId, redeemedAt])
  @@index([companyId, redeemedAt])
  @@index([offerId, redeemedAt])
  @@index([redeemedAt, discountAmount, savingsAmount])
  @@index([merchantId, redeemedAt, discountAmount, savingsAmount])
  @@index([employeeId, isSaved])
  @@index([employeeId, isRedeemed])
  @@index([offerId, isVerified]) // merchant's pending-verification queue
  @@index([employeeId, loggedSavingAmount])
  @@map("redemptions")
}

enum SavingMethod {
  AUTO_PERCENTAGE
  AUTO_FIXED
  MANUAL
}

enum SavingValidationStatus {
  VALID
  INVALID
  NOT_VERIFIABLE
  SKIPPED
}

model RedemptionAnalytics {
  id               String   @id @default(uuid()) @db.Uuid
  merchantId       String   @db.Uuid
  companyId        String?  @db.Uuid
  offerId          String?  @db.Uuid
  date             DateTime @db.Date
  totalRedemptions Int      @default(0)
  totalDiscount    Decimal  @default(0) @db.Decimal(14, 2)
  totalSavings     Decimal  @default(0) @db.Decimal(14, 2)
  uniqueEmployees  Int      @default(0)
  averageDiscount  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([merchantId, date])
  @@index([merchantId, date])
  @@index([companyId, date])
  @@index([offerId, date])
  @@map("redemption_analytics")
}

model IssueReport {
  id           String      @id @default(uuid()) @db.Uuid
  merchantId   String      @db.Uuid
  employeeId   String?     @db.Uuid
  redemptionId String?     @db.Uuid
  title        String      @db.VarChar(255)
  description  String
  category     String      @db.VarChar(50)
  priority     String      @default("normal") @db.VarChar(20)
  status       IssueStatus @default(OPEN)
  adminId      String?     @db.Uuid
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  admin        AdminUser?  @relation("AdminIssueReview", fields: [adminId], references: [id])
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  merchant     Merchant    @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([employeeId])
  @@index([status])
  @@index([status, priority])
  @@map("issue_reports")
}

model ActionQueueItem {
  id            String            @id @default(uuid()) @db.Uuid
  type          ActionQueueType
  title         String            @db.VarChar(255)
  description   String?
  referenceId   String            @db.Uuid
  referenceType String            @db.VarChar(50)
  status        ActionQueueStatus @default(PENDING)
  priority      Int               @default(0)
  assignedTo    String?           @db.Uuid
  merchantId    String?           @db.Uuid
  metadata      Json?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  admin         AdminUser?        @relation(fields: [assignedTo], references: [id])
  merchant      Merchant?         @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([status])
